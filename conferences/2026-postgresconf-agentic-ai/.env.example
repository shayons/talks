# Native setup: copy to .env and configure your dedicated demo database.
# Provider settings: see docs/STREAMING.md.

# The app binds to loopback by default so the demo is not exposed on the LAN.
APP_HOST=127.0.0.1
APP_PORT=8017

# local | aurora — controls whether the app talks to local pg or Aurora Serverless v2.
DEMO_MODE=local

# Used when DEMO_MODE=local.
DATABASE_URL=postgresql://coffee:coffee@127.0.0.1:5432/coffee

# Used when DEMO_MODE=aurora.
# - FastAPI/seed.py use a TLS PostgreSQL connection built from the endpoint and
#   managed Secrets Manager secret.
# - mcp_server.py uses RDS Data API only; it does not need VPC/database routing.
# AURORA_CLUSTER_ENDPOINT=coffee-demo.cluster-xxxx.us-east-1.rds.amazonaws.com
# AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:ACCOUNT:cluster:coffee-demo
# AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:rds!cluster-...
# AURORA_DATABASE=coffee
# AURORA_PORT=5432

# Optional teardown.sh overrides.
# AURORA_CLUSTER_ID=coffee-demo
# AURORA_INSTANCE_ID=coffee-demo-1

# Changing embedding models requires re-embedding catalog and tool vectors.
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# Strands chat: bedrock-openai (default), bedrock-claude, or openai.
# See docs/STREAMING.md for model access, streaming, and billing details.
# CHAT_MODEL_ROUTE=bedrock-openai
# AWS_REGION=us-east-1
# BEDROCK_INTENT_MODEL=us.openai.gpt-5.6-luna
# BEDROCK_RESPONSE_MODEL=us.openai.gpt-5.6-sol
# BEDROCK_HAIKU_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_SONNET_MODEL=us.anthropic.claude-sonnet-5
# OPENAI_INTENT_MODEL=gpt-5.6-luna
# OPENAI_RESPONSE_MODEL=gpt-5.6-sol
# OPENAI_API_KEY=  # Set locally for direct OpenAI; never commit a real key.

# Enable the bounded price and synthetic-index experiments for a local rehearsal.
# These controls are for a trusted demo, not authenticated public hosting.
ENABLE_STAGE_CONTROLS=0
