# Copy to .env. Everything has a working default for the local lab.

# Which BEIR dataset to work on: fiqa (default), scifact, nfcorpus, or scidocs.
# Each lives in its own database on the cluster started by ./scripts/setup.sh.
LAB_DATASET=fiqa
# DATABASE_URL overrides the dataset's database entirely:
# DATABASE_URL=postgresql://coffee:coffee@127.0.0.1:5433/fiqa

# Amazon Bedrock: Cohere Embed v4 and Cohere Rerank 3.5 in us-east-1.
AWS_REGION=us-east-1
# AWS_PROFILE=default
# EMBED_MODEL_ID=us.cohere.embed-v4:0
# RERANK_MODEL_ID=cohere.rerank-v3-5:0
